<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.benmclean.wolf3d</id>
  <name>WolfSharp</name>
  <summary>Wolfenstein 3-D engine recreation for VR</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <description>
    <p>
      WolfSharp is a C# recreation of the Wolfenstein 3-D engine built for VR headsets
      (including Valve's Steam Frame) and flat-screen play. It plays original Wolfenstein
      3-D data files that you supply yourself; no game content is included.
    </p>
    <p>
      This package contains only the engine. You must own a copy of the original
      Wolfenstein 3-D (or a compatible mod) to provide game data files.
    </p>
  </description>
  <launchable type="desktop-id">net.benmclean.wolf3d.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/BenMcLean/WolfSharp/main/promo/screenshots/wolf3d1-01.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/BenMcLean/WolfSharp/main/promo/screenshots/n3d1-01.png</image>
    </screenshot>
  </screenshots>
